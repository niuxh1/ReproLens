REPROLENS_ADDR=127.0.0.1:8080
REPROLENS_DATA_DIR=./data
REPROLENS_RUNNER=auto
REPROLENS_ENABLE_GPU=false
REPROLENS_LLM_BASE_URL=http://127.0.0.1:8788/v1
REPROLENS_LLM_API_KEY=replace-me
REPROLENS_LLM_MODEL=deepseek-v4.1-flash
REPROLENS_LLM_TIMEOUT=60s
REPROLENS_LLM_VISION=true

# Optional code implementation agent (none | claude | codex | gemini | command)
REPROLENS_CODE_AGENT=none
REPROLENS_CODE_AGENT_CMD=
REPROLENS_CODE_AGENT_TIMEOUT=10m
REPROLENS_CODE_AGENT_RUN_ACCEPTANCE=false

# Remote SSH runner (REPROLENS_RUNNER=ssh)
REPROLENS_SSH_HOST=
REPROLENS_SSH_PORT=22
REPROLENS_SSH_IDENTITY=
REPROLENS_SSH_BASE_DIR=/tmp/reprolens

# Colab-compatible rental platform (REPROLENS_RUNNER=colab)
REPROLENS_PLATFORM_BASE_URL=
REPROLENS_PLATFORM_API_KEY=
REPROLENS_PLATFORM_PROVIDER=colab
REPROLENS_PLATFORM_IMAGE=python:3.11-slim
REPROLENS_PLATFORM_GPU_TYPE=
REPROLENS_PLATFORM_MIN_VRAM_GB=16
REPROLENS_PLATFORM_MAX_HOURLY_USD=1.0
REPROLENS_PLATFORM_POLL_INTERVAL=2s
REPROLENS_PLATFORM_TIMEOUT=30m
