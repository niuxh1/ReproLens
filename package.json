{
  "name": "reprolens",
  "version": "0.2.0",
  "description": "Claim-driven scientific reproduction agent with deterministic verification and evidence packaging",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "reprolens": "dist/cli.js"
  },
  "scripts": {
    "reprolens": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "tsx src/cli.ts serve",
    "demo": "tsx src/cli.ts demo",
    "colab-demo": "tsx src/cli.ts colab-demo",
    "ssh-demo": "tsx src/cli.ts ssh-demo",
    "mock-colab": "tsx src/cli.ts mock-colab",
    "check-llm": "tsx src/cli.ts check-llm"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "@napi-rs/canvas": "^0.1.100",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^13.2.0",
    "commander": "^14.0.2",
    "fastify": "^5.12.8",
    "lucide": "^0.468.0",
    "pdfjs-dist": "^5.7.284",
    "tar": "^7.5.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/tar": "^6.1.13",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
