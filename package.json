{
  "name": "reprolens",
  "version": "0.3.0",
  "description": "Claim-driven scientific reproduction agent with deterministic verification and evidence packaging",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "reprolens": "dist/cli.js"
  },
  "scripts": {
    "start": "tsx src/cli.ts serve",
    "reprolens": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "tsx src/cli.ts serve",
    "demo": "tsx src/cli.ts demo",
    "ssh-demo": "tsx src/cli.ts ssh-demo",
    "check-llm": "tsx src/cli.ts check-llm",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start:prod": "node dist/cli.js serve",
    "prepack": "npm run build",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^11.0.0",
    "@napi-rs/canvas": "^0.1.100",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.2.0",
    "commander": "^14.0.2",
    "fastify": "^5.12.8",
    "lucide": "^0.468.0",
    "marked": "^15.0.12",
    "pdfjs-dist": "^6.5.438",
    "sanitize-html": "^2.18.2",
    "tar": "^7.5.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/tar": "^6.1.13",
    "@vitest/coverage-v8": "^5.1.2",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  },
  "files": [
    "dist/**",
    "public/**",
    "assets/**",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/niuxh1/ReproLens.git"
  }
}
